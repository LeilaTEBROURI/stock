---
import { getProducts, getStockStats } from "../lib/db.js";

const products = getProducts();
const stats = getStockStats();

const statusOf = (quantity, minimum) => {
  if (quantity === 0) return { label: "Rupture", className: "danger" };
  if (quantity <= minimum) return { label: "Stock faible", className: "warning" };
  return { label: "Disponible", className: "success" };
};

const formatCurrency = (value) =>
  new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR"
  }).format(value);

const formatDate = (value) =>
  new Intl.DateTimeFormat("fr-FR", {
    dateStyle: "short",
    timeStyle: "short"
  }).format(new Date(value + "Z"));
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestion du stock</title>
  <meta name="description" content="Tableau de bord SSR AstroJS pour le suivi des stocks." />
  <style>
    :root {
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #172033;
      background: #f4f7fb;
      font-synthesis: none;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top right, rgba(59, 130, 246, .10), transparent 35%),
        #f4f7fb;
    }

    .shell {
      max-width: 1220px;
      margin: 0 auto;
      padding: 32px 22px 50px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 28px;
    }

    h1 {
      margin: 0 0 7px;
      font-size: clamp(28px, 4vw, 42px);
      letter-spacing: -1.2px;
    }

    .subtitle {
      margin: 0;
      color: #667085;
      font-size: 15px;
    }

    .server-badge {
      background: white;
      border: 1px solid #e4e9f1;
      border-radius: 12px;
      padding: 10px 14px;
      color: #475467;
      font-size: 13px;
      white-space: nowrap;
    }

    .server-badge strong { color: #111827; }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat {
      background: white;
      border: 1px solid #e4e9f1;
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 5px 18px rgba(16, 24, 40, .04);
    }

    .stat-label {
      color: #667085;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 27px;
      font-weight: 750;
      letter-spacing: -.5px;
    }

    .stat-warning .stat-value { color: #b54708; }

    .panel {
      background: white;
      border: 1px solid #e4e9f1;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 8px 28px rgba(16, 24, 40, .05);
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 22px;
      border-bottom: 1px solid #edf0f5;
    }

    .panel-head h2 {
      margin: 0;
      font-size: 18px;
    }

    .count {
      color: #667085;
      font-size: 13px;
    }

    .table-wrap { overflow-x: auto; }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th {
      text-align: left;
      background: #fafbfc;
      color: #667085;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .05em;
      font-weight: 650;
      padding: 13px 18px;
      border-bottom: 1px solid #edf0f5;
    }

    td {
      padding: 15px 18px;
      border-bottom: 1px solid #f0f2f6;
      font-size: 14px;
      vertical-align: middle;
    }

    tbody tr:hover { background: #fbfcfe; }
    tbody tr:last-child td { border-bottom: 0; }

    .product-name { font-weight: 650; color: #172033; }
    .reference { color: #667085; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
    .category { color: #475467; }

    .quantity {
      font-weight: 750;
      font-size: 16px;
    }

    .threshold {
      color: #667085;
      font-size: 12px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .badge::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }

    .success { color: #027a48; background: #ecfdf3; }
    .warning { color: #b54708; background: #fffaeb; }
    .danger { color: #b42318; background: #fef3f2; }

    footer {
      text-align: center;
      margin-top: 18px;
      color: #98a2b3;
      font-size: 12px;
    }

    @media (max-width: 850px) {
      .stats { grid-template-columns: repeat(2, 1fr); }
      header { align-items: start; flex-direction: column; }
    }

    @media (max-width: 520px) {
      .shell { padding: 22px 14px 35px; }
      .stats { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body>
  <main class="shell">
    <header>
      <div>
        <h1>État du stock</h1>
        <p class="subtitle">Tableau de bord des produits — rendu côté serveur avec Astro SSR.</p>
      </div>
      <div class="server-badge">
        <strong>SSR</strong> · SQLite · Bun
      </div>
    </header>

    <section class="stats" aria-label="Indicateurs du stock">
      <article class="stat">
        <div class="stat-label">Produits référencés</div>
        <div class="stat-value">{stats.total_products}</div>
      </article>

      <article class="stat">
        <div class="stat-label">Unités en stock</div>
        <div class="stat-value">{stats.total_units}</div>
      </article>

      <article class="stat">
        <div class="stat-label">Valeur du stock</div>
        <div class="stat-value">{formatCurrency(stats.stock_value)}</div>
      </article>

      <article class:list={["stat", stats.low_stock > 0 && "stat-warning"]}>
        <div class="stat-label">Alertes de stock</div>
        <div class="stat-value">{stats.low_stock}</div>
      </article>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Produits</h2>
        <span class="count">{products.length} références</span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Produit</th>
              <th>Catégorie</th>
              <th>Stock</th>
              <th>Seuil minimum</th>
              <th>Prix unitaire</th>
              <th>État</th>
              <th>Mise à jour</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => {
              const status = statusOf(product.quantity, product.minimum_stock);
              return (
                <tr>
                  <td>
                    <div class="product-name">{product.name}</div>
                    <div class="reference">{product.reference}</div>
                  </td>
                  <td class="category">{product.category}</td>
                  <td class="quantity">{product.quantity}</td>
                  <td class="threshold">{product.minimum_stock}</td>
                  <td>{formatCurrency(product.unit_price)}</td>
                  <td>
                    <span class:list={["badge", status.className]}>
                      {status.label}
                    </span>
                  </td>
                  <td class="threshold">{formatDate(product.updated_at)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <footer>
      Données chargées depuis SQLite côté serveur · Astro SSR + Bun
    </footer>
  </main>
</body>
</html>
